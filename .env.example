# Gnani speech APIs (Prisma and Timbre). Leave empty to use mock speech.
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
# Only matters with "Detect automatically" on: 1 = once a person's language is confirmed,
# tell Prisma to expect it (may help very short clips, but then Pata can't notice a switch).
PRISMA_LOCK_LANGUAGE=0
# How many nearby place names to give Prisma as hints (0 turns hints off).
PRISMA_KEYTERMS_MAX=60

# Evon, served by vLLM, SGLang or llama.cpp (see scripts/serve_evon.sh).
# Leave empty to use mock Evon. Example: http://10.0.0.5:8000/v1
EVON_BASE_URL=
EVON_MODEL=model
EVON_API_KEY=EMPTY
# 1 makes the server guarantee valid JSON for Evon's quick replies (llama.cpp and vLLM both
# support it). Set 0 only if your server rejects it.
EVON_JSON_MODE=1
EVON_TIMEOUT_S=120
# Evon reasons before matching places and writing doorstep notes. On a slower GPU,
# cap it (e.g. 2500) or switch it off (EVON_REASONING=0) if Pata's question takes too long.
EVON_REASONING=1
EVON_REASONING_TOKENS=3000

# Force one service into mock (1) or live (0) mode. Empty means automatic:
# mock when its key or URL above is empty.
MOCK_PRISMA=
MOCK_EVON=
MOCK_TIMBRE=

# Every Timbre v3.0 voice speaks all ten languages.
TIMBRE_VOICE_RIDER=Yashraj
TIMBRE_VOICE_CUSTOMER=Shivani
TIMBRE_SAMPLE_RATE=44100

# Map data and demo order
PLACES_FILE=data/places_demo.json
ORDERS_FILE=data/orders_demo.json
